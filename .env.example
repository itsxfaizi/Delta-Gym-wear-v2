# Public Supabase runtime configuration. These values are safe for the browser,
# but must still be supplied by the deployment environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only configuration. Never expose this key to a client bundle.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DELTA_TENANT_ID=
APP_URL=

# Optional server-only observability setting.
LOG_LEVEL=info

# Optional browser-safe application name.
NEXT_PUBLIC_APP_NAME=Delta Gym Wear
NEXT_PUBLIC_SITE_URL=http://localhost:3000
