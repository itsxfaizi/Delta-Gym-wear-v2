# Supabase project URL. Required. Safe for the browser (ships in the client bundle).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key. Required. Safe for the browser — access is meant
# to be governed by Postgres Row Level Security, not by keeping this key secret.
# Run scripts/enable-rls-and-realtime.mjs before this key is exposed in a real
# deployment, or it can read every row in every v2 table (see docs/deployment.md).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. Optional, but required for any admin/server mutation
# path that bypasses RLS. Server-only — never expose to a client bundle. Must not
# equal NEXT_PUBLIC_SUPABASE_ANON_KEY (src/server/env.ts rejects that).
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (the same Supabase database, drizzle access). Optional
# at the env-schema level, but most reads/writes throw without it: catalog, cart,
# orders, admin, and account pages all fall back to a no-database/empty state when
# unset, so treat it as required for anything beyond a static shell. Server-only.
DATABASE_URL=

# UUID of the single Delta tenant row that owns every product/order/customer record
# in this database. Optional at the schema level but required for any
# database-backed catalog, cart, order, or admin read/write. Server-only.
DELTA_TENANT_ID=

# Manual-testing exception accepted only on the isolated codex/feedback-expansion
# Vercel Preview branch and its matching non-production Supabase project. Never
# set either variable in Production or another deployment environment.
DELTA_PREVIEW_MFA_DISABLED=
DELTA_PREVIEW_MFA_DISABLED_SUPABASE_REF=

# Canonical app URL used by server-side auth/redirect logic. Required. Server-only.
# In Vercel this should be the production domain, e.g. https://delta-gym-wear.example.
APP_URL=

# Enable only after isolated default-template invite redirect verification and
# allow-listing APP_URL/auth/invite in Supabase. Server-only.
DELTA_INVITE_REDIRECT_READY=

# Optional email delivery, independently gated. Keep unset until actual SMTP
# delivery to intended recipients is verified. Owner-shared invitation links
# require no mail provider. Server-only.
DELTA_INVITE_EMAIL_READY=

# Optional legacy token-hash template mode. Enable only after verifying that
# custom template with /auth/callback. Takes priority over redirect mode. Server-only.
DELTA_INVITE_TEMPLATE_TOKEN_HASH_READY=

# Random secret (16+ characters) used by Vercel's daily image and audit cleanup
# jobs. Configure only after migrations 0006 and 0007 are applied. Server-only.
CRON_SECRET=

# Log verbosity for server-side structured logs. Optional, defaults to "info".
# One of: debug | info | warn | error. Server-only.
LOG_LEVEL=info

# Display name used in page titles/metadata. Optional, defaults to "Delta Gym Wear".
# Safe for the browser.
NEXT_PUBLIC_APP_NAME=Delta Gym Wear

# Canonical public site URL, used for metadataBase and structured data (og/JSON-LD).
# Optional — falls back to http://localhost:3000 if unset, which is wrong for any
# real deployment, so set it explicitly in Vercel. Safe for the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Order-confirmation email transport (src/server/mail). All values are server-only.
# Leave MAIL_PROVIDER unset to log order emails to the console in development.
# Set MAIL_PROVIDER=smtp to send through authenticated SMTP (Resend uses
# smtp.resend.com:465, user "resend", and a Resend API key as the password).
# Or set MAIL_PROVIDER=http to use the existing Resend-compatible HTTP adapter.
MAIL_PROVIDER=
# SMTP relay settings. Required only when MAIL_PROVIDER=smtp.
MAIL_SMTP_HOST=smtp.resend.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=resend
MAIL_SMTP_PASS=
# API key for the HTTP mail provider. Required only when MAIL_PROVIDER=http.
MAIL_API_KEY=
# Verified sender address for outgoing order confirmations. Required by smtp/http.
MAIL_FROM=
# Override the mail API endpoint (defaults to Resend's /emails endpoint). Optional,
# only used when MAIL_PROVIDER=http and the provider isn't Resend-compatible at the
# default URL.
MAIL_API_URL=
